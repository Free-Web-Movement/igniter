<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp"
    tools:context=".activities.DomainMonitorActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/domainText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#212121"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="example.com" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            tools:text="Proxy · 3 hits (locked)" />
    </LinearLayout>

    <Button
        android:id="@+id/btnProxy"
        style="@style/DomainRulePolicyBtn"
        android:layout_marginEnd="4dp"
        android:text="@string/domain_monitor_btn_proxy" />

    <Button
        android:id="@+id/btnDirect"
        style="@style/DomainRulePolicyBtn"
        android:layout_marginEnd="4dp"
        android:text="@string/domain_monitor_btn_direct" />

    <Button
        android:id="@+id/btnUnlock"
        style="@style/DomainRulePolicyBtn"
        android:text="@string/domain_monitor_btn_unlock" />

</LinearLayout>
