<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activities.exempt.fragment.ExemptAppFragment">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:text="@string/exempt_app_page_desc"
        android:textColor="#757575"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/searchExemptAppEt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:hint="@string/proxy_search_hint"
        android:inputType="text"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/proxyTabNormal"
            style="@style/DomainRuleTab"
            android:text="@string/proxy_tab_normal" />

        <TextView
            android:id="@+id/proxyTabSystem"
            style="@style/DomainRuleTab"
            android:layout_marginStart="8dp"
            android:text="@string/proxy_tab_system" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSelectAll"
            style="@style/DomainRulePolicyBtn"
            android:text="@string/proxy_select_all" />

        <TextView
            android:id="@+id/btnDeselectAll"
            style="@style/DomainRulePolicyBtn"
            android:layout_marginStart="8dp"
            android:text="@string/proxy_deselect_all" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSaveProxyApps"
            style="@style/DomainRulePolicyBtn"
            android:text="@string/proxy_save" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/exemptAppRv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:reverseLayout="false" />
</LinearLayout>
