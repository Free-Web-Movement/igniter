<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/serverAddrTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="rpc.vigcoin.org" />

        <TextView
            android:id="@+id/serverPingTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxWidth="150dp"
            android:singleLine="true"
            android:textSize="12sp"
            android:textColor="#757575"
            tools:text="45ms / 52ms" />

        <TextView
            android:id="@+id/currentServerBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_badge_current"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="@string/server_list_current"
            android:textColor="#1565C0"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/playServerBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/server_list_play"
            android:padding="8dp"
            android:src="@drawable/ic_action_play" />

        <ImageButton
            android:id="@+id/stopServerBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/server_list_stop"
            android:padding="8dp"
            android:src="@drawable/ic_action_stop" />

        <ImageButton
            android:id="@+id/moreServerBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/server_list_more"
            android:padding="10dp"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <TextView
        android:id="@+id/serverUrlTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#757575"
        android:textSize="12sp"
        tools:text="trojan://password@rpc.vigcoin.org:3333" />
</LinearLayout>
